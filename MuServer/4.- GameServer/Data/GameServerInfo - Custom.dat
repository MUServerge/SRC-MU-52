[GameServerInfo]
;==================================================
; Announce Chaos Mix Settings
; AnnounceChaosMixLevel: 0 ~ 5
;==================================================
AnnounceChaosMix = 1
AnnounceChaosMixLevel = 5
AnnounceChaosMixSuccess = Congratulations to %s. Item %s has been successfully upgraded to +%d.
AnnounceChaosMixFailure = %s so sorry! Item %s failed to upgrade to +%d.

;==================================================
; Custom Arena Settings
;==================================================
CustomArenaSwitch = 1
CustomArenaVictimScoreDecrease = 10
CustomArenaKillerScoreIncrease = 100
CustomArenaText1 = [%s] will close in %d minutes.
CustomArenaText2 = [%s] is closed.
CustomArenaText3 = [%s] will start in %d minutes.
CustomArenaText4 = [%s] has started.
CustomArenaText5 = [%s] has finished.
CustomArenaText6 = [%s] %s is the winner.
CustomArenaText7 = [%s] You reached rank %d with %d points.
CustomArenaText8 = You cannot enter the arena.
CustomArenaText9 = The arena is currently not open.
CustomArenaText10 = Maximum number of players exceeded.
CustomArenaText11 = You must be at least level %d.
CustomArenaText12 = Your maximum level must be %d.
CustomArenaText13 = You must be at least Master Level %d.
CustomArenaText14 = Your maximum Master Level must be %d.
CustomArenaText15 = You must have at least %d Resets.
CustomArenaText16 = You can only have a maximum of %d Resets.
CustomArenaText17 = You must have at least %d Master Resets.
CustomArenaText18 = You can only have a maximum of %d Master Resets.
CustomArenaText19 = Your character class is not allowed to enter the arena.

;==================================================
